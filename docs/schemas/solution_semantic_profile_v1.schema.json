{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auditor-ia.local/schemas/solution_semantic_profile_v1.schema.json",
  "title": "solution_semantic_profile_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "problem_id",
    "solution_path_id",
    "source",
    "method",
    "concepts_used",
    "skills_used",
    "steps_summary",
    "properties_used",
    "representation",
    "evidence",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "solution_semantic_profile_v1"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "solution_path_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "problem_source",
        "solution_source"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human_solution",
            "book_solution",
            "model_draft",
            "teacher_solution",
            "unknown"
          ]
        },
        "problem_source": {
          "type": "string"
        },
        "solution_source": {
          "type": "string"
        }
      }
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "concepts_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "skills_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "properties_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "central",
              "supporting",
              "checking"
            ]
          },
          "notes": {
            "type": "string",
            "default": ""
          }
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedding_text",
        "canonical_solution_type",
        "search_keywords"
      ],
      "properties": {
        "embedding_text": {
          "type": "string",
          "minLength": 1
        },
        "canonical_solution_type": {
          "type": "string",
          "minLength": 1
        },
        "search_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "solution_text_latex",
        "uses_figure",
        "figure_tags"
      ],
      "properties": {
        "solution_text_latex": {
          "type": "string"
        },
        "uses_figure": {
          "type": "boolean"
        },
        "figure_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "human_verified",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "sin_revisar",
            "revisado",
            "requiere_correccion"
          ]
        },
        "human_verified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
